{% extends 'base.html.twig' %}
{% block title%}New Post{% endblock %}
{% block body%}

<!-- Principal Content Start -->
<div id="new Post">
    <div class="container">
        <div class="col-xs-12 col-sm-8 col-sm-push-2">
            <h1>New Post</h1>
            {{ form_start(postForm, {'attr': {'class':'form-horizontal'}}) }}
            <div class="form-group">
                {{ form_row(postForm.title, {'attr': {'class':'form-control'}}) }}
                {{ form_row(postForm.content, {'attr': {'class':'form-control'}}) }}
                {{ form_row(postForm.image, {'attr': {'class':'form-control'}}) }}
                {{ form_row(postForm.Send, {'attr': {'class':'btn btn-primary'}}) }}
            </div>
            {{ form_end(postForm) }}
            <hr class="divider">
        </div>
    </div>
</div>
<!-- Principal Content Start -->
{% endblock %}