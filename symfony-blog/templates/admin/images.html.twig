{% extends 'base.html.twig' %}
{% block title%}Images{% endblock %}
{% block body%}
<!-- Principal Content Start -->
<div id="images">
    <div class="container">
        <div class="col-xs-12 col-sm-8 col-sm-push-2">
            <h1>Images</h1>
            {{ form_start(Imageform, {'attr': {'class':'form-horizontal'}}) }}
            <div class="form-group">
                {{ form_row(Imageform.file, {'attr': {'class':'form-control'}}) }}
                {{ form_row(Imageform.category, {'attr': {'class':'form-control'}}) }}
                {{ form_row(Imageform.Send, {'attr': {'class':'btn btn-primary'}}) }}
            </div>
            {{ form_end(Imageform) }}
            <hr class="divider">
            <hr class="divider">
        </div>
    </div>
</div>

<!-- Principal Content Start -->
{% endblock %}